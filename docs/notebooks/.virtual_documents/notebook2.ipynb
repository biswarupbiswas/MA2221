x = 3.1415926535
n = 42

print(f"x = {x}")
print(f"x = {x:.3f}")        # 3 decimal places
print(f"n = {n:6d}")         # width 6, right-aligned
print(f"n = {n:<6d}")        # left-aligned
print(f"n = {n:^6d}")        # centered





x = 1234.56789

